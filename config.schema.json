{
    "pluginAlias": "MyHome",
    "pluginType": "platform",
    "schema": {
        "type": "object",
        "properties": {
            "expose": {
                "title": "Expose devices through",
                "type": "string",
                "default": "homekit",
                "description": "Choose HomeKit, Matter, or both. Matter must also be enabled on this Homebridge bridge. Switching protocols changes the accessories paired with your apps.",
                "oneOf": [
                    { "title": "HomeKit", "enum": ["homekit"] },
                    { "title": "Matter", "enum": ["matter"] },
                    { "title": "HomeKit and Matter", "enum": ["both"] }
                ]
            },
            "name": {
                "title": "Name",
                "type": "string",
                "required": true,
                "default": "MyHome"
            },
            "host": {
                "title": "MyHome server address",
                "type": "string",
                "required": true,
                "default": "192.168.1.35"
            },
            "port": {
                "title": "MyHome server port",
                "type": "integer",
                "required": false,
                "minimum": 1,
                "maximum": 65535,
                "default": 20000
            },
            "password": {
                "title": "MyHome server password",
                "type": "string",
                "required": false,
                "default": "",
                "description": "Legacy gateways use a numeric password. SHA-1/SHA-256 gateways accept up to 30 alphanumeric characters. Leave empty for a trusted IP connection.",
                "pattern": "^[A-Za-z0-9]{0,30}$"
            },
            "maxConcurrent": {
                "title": "Max concurrent commands",
                "description": "Optional override for the max simultaneous TCP command connections (1–10). If omitted the plugin queries the gateway model and sets it automatically.",
                "type": "integer",
                "required": false,
                "minimum": 1,
                "maximum": 10
            },
            "autoDiscover": {
                "title": "Auto-discover devices",
                "description": "Scan the gateway for devices not in config and register them automatically as placeholder accessories. Restart Homebridge to re-run the scan.",
                "type": "boolean",
                "required": false,
                "default": false
            },
            "autoDiscoverMaxAddr": {
                "title": "Auto-discover max address",
                "description": "Maximum address (1..N) probed per WHO type during auto-discovery. Higher values find more devices but take longer. Default: 20.",
                "type": "integer",
                "required": false,
                "minimum": 1,
                "maximum": 99,
                "default": 20
            },
            "lights": {
                "title": "Lights",
                "buttonText": "Add Light",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "title": "id",
                            "type": "integer",
                            "required": true,
                            "minimum": 1
                        },
                        "name": {
                            "title": "Name",
                            "type": "string",
                            "required": false
                        },
                        "dimmer": {
                            "title": "Dimmer",
                            "description": "Enable dimmer support (OWN levels 2-10 = 20%-100%, in 10% steps)",
                            "type": "boolean",
                            "required": false,
                            "default": false
                        },
                        "where": {
                            "title": "Custom WHERE address",
                            "description": "Optional raw OpenWebNet WHERE address for special relay configurations (e.g. \"68#4#01\"). Defaults to id.",
                            "type": "string",
                            "required": false
                        }
                    }
                }
            },
            "blinds": {
                "title": "Blinds",
                "buttonText": "Add blind",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "title": "id",
                            "type": "integer",
                            "required": true,
                            "minimum": 1
                        },
                        "name": {
                            "title": "Name",
                            "type": "string",
                            "required": false
                        },
                        "where": {
                            "title": "Custom WHERE address",
                            "description": "Raw shutter address, e.g. 68#4#01 for a local bus. Defaults to id.",
                            "type": "string",
                            "pattern": "^#?[0-9]+(#[0-9]+)*$"
                        },
                        "time": {
                            "title": "Travel time (s)",
                            "description": "Default linear travel duration for both directions. Set this, or both timeUp and timeDown. Slat rotation is added separately.",
                            "type": "number",
                            "required": false,
                            "minimum": 0.1,
                            "maximum": 3600
                        },
                        "timeUp": {
                            "title": "Opening travel time (s)",
                            "description": "Overrides time for opening; excludes slat rotation.",
                            "type": "number",
                            "minimum": 0.1,
                            "maximum": 3600
                        },
                        "timeDown": {
                            "title": "Closing travel time (s)",
                            "description": "Overrides time for closing; excludes slat rotation.",
                            "type": "number",
                            "minimum": 0.1,
                            "maximum": 3600
                        },
                        "timeSlat": {
                            "title": "Slat rotation time (s)",
                            "description": "Additional time in seconds for slat rotation (venetian blinds only, leave 0 for roller blinds)",
                            "type": "number",
                            "required": false,
                            "minimum": 0,
                            "maximum": 3600,
                            "default": 0
                        },
                        "slatPercent": {
                            "title": "Slat threshold (%)",
                            "description": "Position (%) below which slat rotation occurs. E.g. 10 means: 10%=blind down slats open, 0%=fully closed. Leave 0 for roller blinds.",
                            "type": "integer",
                            "required": false,
                            "minimum": 0,
                            "maximum": 99,
                            "default": 0
                        },
                        "calibrateOnStart": {
                            "title": "Calibrate on start",
                            "description": "Legacy option, used only when calibration is unset: true = always, false = manual. Saved positions are restored with their confidence.",
                            "type": "boolean",
                            "required": false,
                            "default": true
                        },
                        "calibration": {
                            "title": "Calibration policy",
                            "description": "Overrides calibrateOnStart. Unknown partial positions require a full opening/closing or a successful calibration first.",
                            "type": "string",
                            "oneOf": [
                                { "title": "At every startup", "enum": ["always"] },
                                { "title": "At startup if position is unknown", "enum": ["whenUnknown"] },
                                { "title": "Manual (adds a calibration control)", "enum": ["manual"] }
                            ]
                        },
                        "calibrationSwitch": {
                            "title": "Show calibration control",
                            "description": "Adds a linked calibration switch to HomeKit and Matter. Always enabled with the explicit manual policy. Turn it off to stop calibration.",
                            "type": "boolean",
                            "default": false
                        },
                        "postStopGraceMs": {
                            "title": "Post-STOP packet filter (ms)",
                            "description": "Filters one repeated direction packet after a wall STOP (F454 quirk). Set to 0 to disable.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000,
                            "default": 150
                        }
                    }
                }
            },
            "thermostats": {
                "title": "Thermostats",
                "buttonText": "Add Thermostat",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "title": "id",
                            "type": "integer",
                            "required": true,
                            "minimum": 1
                        },
                        "zone": {
                            "title": "zone",
                            "type": "integer",
                            "required": true,
                            "minimum": 1
                        },
                        "where": {
                            "title": "Central / zone WHERE address",
                            "description": "Optional raw control address. Use #1 for zone 1 of a 99-zone central unit. Default: #0#<zone> (legacy configuration).",
                            "type": "string",
                            "pattern": "^#[0-9]+(#[0-9]+)?$"
                        },
                        "matterMode": {
                            "title": "Thermostat capabilities in Matter",
                            "type": "string",
                            "default": "heat",
                            "description": "Select the functions supported by this zone. The MyHome scheduled programme is exposed as a separate automatic-program switch.",
                            "oneOf": [
                                { "title": "Heating", "enum": ["heat"] },
                                { "title": "Cooling", "enum": ["cool"] },
                                { "title": "Heating and cooling", "enum": ["both"] }
                            ]
                        },
                        "name": {
                            "title": "Name",
                            "type": "string",
                            "required": false
                        }
                    }
                }
            },
            "scenarios": {
                "title": "Scenarios",
                "buttonText": "Add Scenario",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "title": "id",
                            "description": "Stable accessory id; also the scenario number unless scenario is specified",
                            "type": "integer",
                            "required": true,
                            "minimum": 1
                        },
                        "scenario": {
                            "title": "Scenario number",
                            "description": "WHO 0 scenario number on the module; defaults to id.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 20
                        },
                        "where": {
                            "title": "Scenario module address",
                            "description": "Required module address (01..99), optionally on a local bus, e.g. 23 or 23#4#01. Address 0 is not a general scenario address.",
                            "type": "string",
                            "required": true,
                            "pattern": "^[0-9]{1,2}(#4#[0-9]{1,2})?$"
                        },
                        "name": {
                            "title": "Name",
                            "type": "string",
                            "required": false
                        }
                    }
                }
            },
            "contacts": {
                "title": "Dry Contacts",
                "buttonText": "Add Contact",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "title": "id",
                            "description": "Stable id: AUX address for legacy WHO 9, channel/ZN for standard WHO 25",
                            "type": "integer",
                            "required": true,
                            "minimum": 1
                        },
                        "protocol": {
                            "title": "Input protocol",
                            "type": "string",
                            "default": "auxiliary",
                            "oneOf": [
                                { "title": "Legacy AUX (WHO 9)", "enum": ["auxiliary"] },
                                { "title": "Dry-contact interface (WHO 25)", "enum": ["dry-contact"] },
                                { "title": "IR detector (WHO 25)", "enum": ["ir"] }
                            ]
                        },
                        "where": {
                            "title": "Raw input WHERE address",
                            "description": "Defaults to id for AUX or 3<id> for WHO 25. Example: channel 1 uses 31; alarm Z=1,N=1 uses 311.",
                            "type": "string",
                            "pattern": "^#?[0-9]+(#[0-9]+)*$"
                        },
                        "name": {
                            "title": "Name",
                            "type": "string",
                            "required": false
                        },
                        "sensorType": {
                            "title": "Sensor type",
                            "description": "How HomeKit displays this dry contact",
                            "type": "string",
                            "required": false,
                            "default": "contact",
                            "oneOf": [
                                { "title": "Contact (door/window)", "enum": ["contact"] },
                                { "title": "Motion (PIR)", "enum": ["motion"] },
                                { "title": "Occupancy", "enum": ["occupancy"] },
                                { "title": "Leak", "enum": ["leak"] },
                                { "title": "Smoke", "enum": ["smoke"] },
                                { "title": "Carbon Monoxide", "enum": ["co"] }
                            ]
                        }
                    }
                }
            },
            "energies": {
                "title": "Energy Monitors",
                "buttonText": "Add Energy Monitor",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "title": "id",
                            "description": "Raw WHO 18 address (e.g. 51 for meter 1), or stable id when where is specified",
                            "type": "integer",
                            "required": true,
                            "minimum": 1
                        },
                        "where": {
                            "title": "Raw energy WHERE address",
                            "description": "Defaults to id. Meters use 5N (e.g. 51); energy actuators use 7N#0 (e.g. 71#0).",
                            "type": "string",
                            "pattern": "^#?[0-9]+(#[0-9]+)*$"
                        },
                        "name": {
                            "title": "Name",
                            "type": "string",
                            "required": false
                        },
                        "asOutlet": {
                            "title": "Expose as outlet",
                            "description": "Use Outlet service with Eve Consumption characteristic instead of LightSensor lux-hack (better Eve.app support)",
                            "type": "boolean",
                            "required": false,
                            "default": false
                        }
                    }
                }
            },
            "doors": {
                "title": "Door / Video Door (intercom)",
                "buttonText": "Add door",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "title": "id",
                            "description": "Door entry / video door address (WHO=7)",
                            "type": "integer",
                            "required": true,
                            "minimum": 1
                        },
                        "name": {
                            "title": "Name",
                            "type": "string",
                            "required": false
                        },
                        "openCommand": {
                            "title": "OWN open command",
                            "description": "OWN command to send to release the door (defaults to *7*19*<id>##)",
                            "type": "string",
                            "required": false
                        },
                        "doorbell": {
                            "title": "Expose as Doorbell too",
                            "description": "Adds a linked Doorbell service that fires SINGLE_PRESS when an incoming call is received on the bus",
                            "type": "boolean",
                            "required": false,
                            "default": false
                        }
                    }
                }
            }
        }
    }
}
